    "actorLineColor": "#55524B",
    "signalColor": "#111111",
    "signalTextColor": "#111111",
    "labelBoxBkgColor": "#FFD43A",
    "labelBoxBorderColor": "#111111",
    "loopTextColor": "#111111",
    "activationBkgColor": "#CCF2DE",
    "activationBorderColor": "#00A05A",
    "clusterBkg": "#F3ECD9",
