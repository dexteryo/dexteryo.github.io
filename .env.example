# Notion integration for auto-logging shared links.
# Copy to `.env` (gitignored) and fill in real values. Never commit `.env`.
#
# NOTION_TOKEN        — Internal Integration Secret from
#                       https://www.notion.so/my-integrations  (starts with "ntn_").
#                       The integration must be connected to the target page/database
#                       (page ••• menu → Connections), or the API returns 404.
# NOTION_DATABASE_ID  — 32-char hex ID of the *database* (not the page). If the table
#                       is an inline database, open it as a full page and copy the ID
#                       from that URL.
NOTION_TOKEN=
NOTION_DATABASE_ID=
